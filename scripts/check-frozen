#!/usr/bin/env bash
# Frozen-set check: KERNEL.md and INVARIANTS.md (whole files) and the
# `## kernel` and `## invariants` sections of GLOSSARY.md keep the bytes Jang
# promoted. Each item's sha256 is pinned in scripts/frozen.sha256. A glossary
# section runs from its heading to the next `## ` heading, trailing blank lines
# dropped, so `## Language` additions and frontmatter updates stay allowed.
#
# Usage: scripts/check-frozen
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# Print item's bytes: a whole file, or FILE#name for the `## name` section.
item() {
  case "$1" in
  *'#'*) awk -v h="## ${1#*#}" '/^## /{f=($0==h)} f{buf=buf $0 "\n"; if (NF) {printf "%s", buf; buf=""}}' "${1%%#*}" ;;
  *) cat "$1" ;;
  esac
}

status=0
n=0
while read -r pin name; do
  [[ -z "$pin" || "$pin" == '#'* ]] && continue
  n=$((n + 1))
  bytes="$(item "$name"; echo .)"
  [[ "$bytes" == . ]] && { echo "FAIL frozen: $name is missing or empty" >&2; status=1; continue; }
  sum="$(printf '%s' "${bytes%.}" | sha256sum | cut -d' ' -f1)"
  if [[ "$sum" != "$pin" ]]; then
    echo "FAIL frozen: $name changed (sha256 $sum, pinned $pin); only a fork Jang promotes changes it" >&2
    status=1
  fi
done <scripts/frozen.sha256
((n == 4)) || { echo "FAIL frozen: scripts/frozen.sha256 pins $n items, expected 4" >&2; status=1; }

[[ "$status" == 0 ]] && echo "PASS frozen: $n pinned items match scripts/frozen.sha256"
exit "$status"
