#!/usr/bin/env bash
# Install the Claude Code shim for this user, on top of an installed roger core.
#
#   shims/claude/install              copy roger-mcp.mjs from this checkout to
#                                     ~/.local/share/roger-shims/claude/ and register it
#                                     as Claude Code user-scope MCP server `roger`
#   shims/claude/install --uninstall  unregister it and remove that directory; Stores stay
#
# Idempotent: rerunning replaces the copy and the registration. Touches nothing
# outside its own directory and the `roger` entry in Claude Code's user config.
# See INSTALL.md.
set -euo pipefail

src="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/roger-mcp.mjs"
dir="$HOME/.local/share/roger-shims/claude"

command -v claude >/dev/null || { echo "claude CLI not found on PATH" >&2; exit 1; }

case "${1:-}" in
"")
  command -v node >/dev/null || { echo "node not found on PATH" >&2; exit 1; }
  [[ -f "$src" ]] || { echo "missing $src" >&2; exit 1; }
  mkdir -p "$dir"
  install -m 0644 "$src" "$dir/roger-mcp.mjs"
  claude mcp remove -s user roger >/dev/null 2>&1 || true
  claude mcp add -s user roger -- node "$dir/roger-mcp.mjs"
  ;;
--uninstall)
  claude mcp remove -s user roger >/dev/null 2>&1 || true
  rm -rf "$dir"
  echo "removed $dir and user-scope MCP server roger; Stores under \${XDG_STATE_HOME:-~/.local/state}/roger-shims/claude are kept"
  ;;
*)
  echo "usage: $0 [--uninstall]" >&2
  exit 2
  ;;
esac
